<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RunAndGunShootWhileFleeing</AssemblyName>
    <RootNamespace>RunAndGunShootWhileFleeing</RootNamespace>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">/root/rimworld_libs</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(GameManagedDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="RimWorld"><HintPath>$(GameManagedDir)/RimWorld.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityStubs"><HintPath>$(GameManagedDir)/UnityStubs.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
  </ItemGroup>
  <Target Name="CopyToAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="1.7/Assemblies" />
  </Target>
</Project>
